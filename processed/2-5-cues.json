      },
      {
        "local_sec": 52.56,
        "global_sec": 618.19,
        "global_frame": 18545,
        "end_frame": 18577,
        "text": "而快取"
      },
      {
        "local_sec": 53.6,
        "global_sec": 619.23,
        "global_frame": 18577,
        "end_frame": 18679,
