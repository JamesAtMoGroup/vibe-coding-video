        "global_sec": 362.29,
        "global_frame": 10868,
        "end_frame": 10928,
        "text": "顯示在畫面上囉"
      }
    ],
    "3.2": [
      {
        "local_sec": 0.0,
        "global_sec": 364.37,
        "global_frame": 10931,
        "end_frame": 10992,
        "text": "那聽到這裡你可能會想說"
