      },
      {
        "local_sec": 57.0,
        "global_sec": 622.63,
        "global_frame": 18679,
        "end_frame": 18741,
        "text": "讓你下次再進入這個網站的時候"
      },
      {
        "local_sec": 59.08,
        "global_sec": 624.71,
