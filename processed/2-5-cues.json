      },
      {
        "local_sec": 84.52,
        "global_sec": 650.15,
        "global_frame": 19504,
        "end_frame": 19579,
        "text": "負責讓資料可以快速的被存取"
      },
      {
        "local_sec": 87.0,
        "global_sec": 652.63,
        "global_frame": 19579,
        "end_frame": 19612,
        "text": "這兩個加起來"
      },
      {
        "local_sec": 88.12,
        "global_sec": 653.75,
        "global_frame": 19612,
        "end_frame": 19729,
        "text": "才能讓整個應用程式穩定又安全的運作"
      },
      {
        "local_sec": 92.0,
        "global_sec": 657.63,
        "global_frame": 19729,
        "end_frame": 19742,
        "text": "好"
      },
      {
        "local_sec": 92.44,
        "global_sec": 658.07,
        "global_frame": 19742,
        "end_frame": 19785,
