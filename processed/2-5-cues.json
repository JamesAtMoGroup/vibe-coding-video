      },
      {
        "local_sec": 35.08,
        "global_sec": 600.71,
        "global_frame": 18021,
        "end_frame": 18087,
        "text": "所以它是整個Web世界的大腦"
      },
      {
        "local_sec": 37.28,
        "global_sec": 602.91,
        "global_frame": 18087,
        "end_frame": 18171,
        "text": "只是你平常會看不太到它"
      },
      {
        "local_sec": 40.08,
        "global_sec": 605.71,
        "global_frame": 18171,
        "end_frame": 18203,
        "text": "第三個是"
      },
      {
        "local_sec": 41.16,
        "global_sec": 606.79,
        "global_frame": 18203,
